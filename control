-- === ЯКОРЬ 1: НАСТРОЙКИ И ОТПРАВКА ===
local GITHUB_USERNAME = "kazzqa"
local REPO_NAME = "executable-script"
local FILE_PATH = "command.lua"
local AUTH_TOKEN = "Bearer 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"

local HttpService = game:GetService("HttpService")
local req = (syn and syn.request) or request

-- Функция отправки кода на Гитхаб
local function sendCommand(luaCode)
    if not req then return end
    local url = string.format("https://github.com", GITHUB_USERNAME, REPO_NAME, FILE_PATH)
    
    -- Получаем SHA файла для перезаписи
    local res = req({Url = url, Method = "GET", Headers = {["Authorization"] = AUTH_TOKEN}})
    local sha = ""
    if res.StatusCode == 200 then
        pcall(function() sha = HttpService:JSONDecode(res.Body).sha end)
    end

-- === ИСПРАВЛЕННЫЙ ЯКОРЬ 2: ОФИЦИАЛЬНЫЙ БАЙПАС ===
    -- Используем встроенный в чит кодировщик Base64 (работает везде)
    local b64 = base64_encode and base64_encode(luaCode) or base64 and base64.encode and base64.encode(luaCode) or crypt and crypt.base64 and crypt.base64.encode and crypt.base64.encode(luaCode)
    
    local payload = {
        message = "Update via UI",
        content = b64,
        sha = sha ~= "" and sha or nil
    }
    
    req({
        Url = url,
        Method = "PUT",
        Headers = {["Authorization"] = AUTH_TOKEN, ["Content-Type"] = "application/json"},
        Body = HttpService:JSONEncode(payload)
    })
end

-- === ЯКОРЬ 3: ОСНОВА ИНТЕРФЕЙСА ===
